// FireLink - Prisma schema
// PostgreSQL. Local dev via Docker (docker-compose.yml); production via hosted Postgres (Vercel/Neon/Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  ADMIN
  SALES
}

enum AvailabilityStatus {
  LOCAL
  IN_STOCK
  INDENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([active])
}

model Product {
  id                 String             @id @default(cuid())
  sku                String             @unique
  name               String
  slug               String             @unique
  brand              String
  modelNumber        String?
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id])
  shortDescription   String?
  description        String?
  availabilityStatus AvailabilityStatus @default(LOCAL)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  images         ProductImage[]
  specifications ProductSpecification[]

  @@index([categoryId])
  @@index([availabilityStatus])
  @@index([active])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl    String
  altText     String?
  displayOrder Int    @default(0)

  @@index([productId])
}

model ProductSpecification {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  specName     String
  specValue    String
  unit         String?
  displayOrder Int     @default(0)

  @@index([productId])
}