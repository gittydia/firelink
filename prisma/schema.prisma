// Fire Protection Equipment - Prisma schema
// PostgreSQL. Local dev via Docker (docker-compose.yml); production via hosted Postgres (Vercel/Neon/Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("FIRELINK_DATABASE_URL")
  directUrl = env("FIRELINK_DATABASE_URL_UNPOOLED")
}

enum UserRole {
  ADMIN
  SALES
}

enum AvailabilityStatus {
  LOCAL
  IN_STOCK
  INDENT
}

enum InquiryNotificationStatus {
  PENDING
  SENT
  FAILED
  // No transport configured, so notification was deliberately not attempted.
  SKIPPED
}

enum VariantReviewStatus {
  PENDING
  NEEDS_REVIEW
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Set to NULL rather than cascading, so a removed staff account never
  // deletes product rows and historical attribution degrades to "unknown".
  inventoryUpdates Product[] @relation("ProductInventoryUpdater")

  @@index([role])
  @@index([active])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([active])
}

model Product {
  id                 String             @id @default(cuid())
  sku                String             @unique
  name               String
  slug               String             @unique
  brand              String
  modelNumber        String?
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id])
  shortDescription   String?
  description        String?
  availabilityStatus AvailabilityStatus @default(LOCAL)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Inventory audit: stamped only when availabilityStatus actually changes.
  // Both stay NULL for products whose availability was never changed after
  // this feature shipped, and for rows created through the admin UI.
  inventoryUpdatedAt   DateTime?
  inventoryUpdatedById String?
  inventoryUpdatedBy   User?   @relation("ProductInventoryUpdater", fields: [inventoryUpdatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  images         ProductImage[]
  specifications ProductSpecification[]
  variants       ProductVariant[]
  inquiryProducts InquiryProduct[]

  @@index([categoryId])
  @@index([availabilityStatus])
  @@index([active])
  @@index([inventoryUpdatedById])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl    String
  altText     String?
  displayOrder Int    @default(0)

  @@index([productId])
}

model ProductSpecification {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  specName     String
  specValue    String
  unit         String?
  displayOrder Int     @default(0)

  @@index([productId])
}

// A priced variant of a product, sourced from the normalized pricelist
// pipeline (pricelist_cleaned/normalized/pricelist_entries.csv). Unique on
// (productId, size, series) — the keycheck identity — with empty size/series
// normalized to '' so a missing value never collapses the key.
// See docs/DECISIONS.md ADR-019 for the import policy.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku    String @unique
  size   String @default("")
  series String @default("")
  unit   String?

  // Pricing. priceHigh stays null unless the source itself prints a range
  // (ADR-014); the pricelist never does.
  unitPrice Decimal?  @db.Decimal(12, 2)
  priceHigh Decimal?  @db.Decimal(12, 2)
  active    Boolean   @default(true)

  // Provenance from the pricelist staging pipeline. PENDING rows import
  // active; NEEDS_REVIEW rows import archived (active = false) so ambiguity
  // is queryable but never public. A variant forced to NEEDS_REVIEW by a
  // price conflict carries the colliding prices in ambiguityNote.
  reviewStatus    VariantReviewStatus @default(NEEDS_REVIEW)
  ambiguityNote   String?
  sourceSlide     Int?
  sourceTable     Int?
  sourceRow       Int?
  sourceColumn    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, series])
  @@index([productId])
  @@index([active])
  @@index([reviewStatus])
}

// A guest inquiry submitted from the public Contact page. Carries no User
// relation on purpose: inquiries are anonymous, so there is no account to
// attribute, revoke, or cascade from.
model Inquiry {
  id        String   @id @default(cuid())
  reference String   @unique
  name      String
  company   String
  email     String
  message   String
  // Point-in-time record of consent rather than a boolean: the policy text can
  // change, and we need to know which version the sender actually agreed to.
  privacyPolicyVersion String
  privacyAcceptedAt    DateTime @default(now())
  // Tracked so a failed notification stays visible on the row instead of
  // being lost. The inquiry is durable either way; the email is best-effort.
  notificationStatus InquiryNotificationStatus @default(PENDING)
  notificationError  String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  products InquiryProduct[]

  @@index([createdAt])
  @@index([notificationStatus])
}

model InquiryProduct {
  id        String  @id @default(cuid())
  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int     @default(1)
  // Snapshotted at submission from the resolved Product so the inquiry stays
  // readable after a rename or archive. productId remains the authority and
  // the relation is still the live source of truth.
  productName        String
  productSku         String
  availabilityStatus AvailabilityStatus
  createdAt          DateTime @default(now())

  @@unique([inquiryId, productId])
  @@index([productId])
}
