# Database
# Local dev (Docker): docker compose up -d first
DATABASE_URL="postgresql://firelink:firelink@localhost:5433/firelink?schema=public"
# Production (Vercel): use your hosted Postgres connection string (Neon / Supabase / Vercel Postgres)

# Auth (NextAuth v5)
AUTH_SECRET="CHANGE_ME_GENERATE_RANDOM_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
UPLOAD_DIR="public/uploads"
