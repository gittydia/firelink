# Database
# Local dev (Docker): docker compose up -d first
DATABASE_URL="postgresql://firelink:firelink@localhost:5433/firelink?schema=public"
# Prisma CLI uses this direct (unpooled) connection for migrations.
# Same value as DATABASE_URL locally; on Neon it's the direct string (no -pooler host).
DATABASE_URL_UNPOOLED="postgresql://firelink:firelink@localhost:5433/firelink?schema=public"
# Production (Vercel/Neon): the integration sets DATABASE_URL (pooled) + DATABASE_URL_UNPOOLED (direct) automatically

# Auth (NextAuth v5)
AUTH_SECRET="CHANGE_ME_GENERATE_RANDOM_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
UPLOAD_DIR="public/uploads"
