# Database
# Local dev (Docker): docker compose up -d first
DATABASE_URL="postgresql://firelink:firelink@localhost:5433/firelink?schema=public"
# Prisma CLI uses this direct (unpooled) connection for migrations.
# Same value as DATABASE_URL locally; on Neon it's the direct string (no -pooler host).
DATABASE_URL_UNPOOLED="postgresql://firelink:firelink@localhost:5433/firelink?schema=public"
# Prisma reads these names (NOT DATABASE_URL) so a Neon/Vercel integration can't override them.
# FIRELINK_DATABASE_URL = pooled connection; FIRELINK_DATABASE_URL_UNPOOLED = direct (migrations).
FIRELINK_DATABASE_URL="postgresql://firelink:firelink@localhost:5433/firelink?schema=public"
FIRELINK_DATABASE_URL_UNPOOLED="postgresql://firelink:firelink@localhost:5433/firelink?schema=public"

# Auth (NextAuth v5)
AUTH_SECRET="CHANGE_ME_GENERATE_RANDOM_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
UPLOAD_DIR="public/uploads"

# Inquiry notifications (optional).
# Leave RESEND_API_KEY unset to run locally: inquiries are still persisted, the
# notification is recorded as SKIPPED, and no email is attempted.
# RESEND_API_KEY="re_..."
# INQUIRY_TO_EMAIL="sales@firelink.example"
# INQUIRY_FROM_EMAIL="website@firelink.example"
